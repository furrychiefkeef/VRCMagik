<Application x:Class="VRCMagik.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VRCMagik.GUI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
         
        <Color x:Key="chan.grad">#FF770832</Color>
        <LinearGradientBrush x:Key="chan.grd" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black" Offset="0"/>
            <GradientStop Color="{DynamicResource chan.grad}" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="chan.gradient" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black" Offset="0"/>
            <GradientStop Color="{DynamicResource chan.grad}" Offset="1"/>
        </LinearGradientBrush>
    </Application.Resources>
</Application>
